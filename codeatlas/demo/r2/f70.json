{"detail":{"file":{"id":70,"repository_id":2,"path":"frontend/app/page.tsx","language":"TypeScript","content_hash":"47d5e4de5a32b459736a94613fad571254c039793d1f9b3cca775c7edef6d25c","line_count":305},"source":"import Link from \"next/link\";\nimport {\n  ArrowRight,\n  ArrowUpRight,\n  Braces,\n  GitBranch,\n  Github,\n  Network,\n  Search,\n  ShieldCheck,\n  Sparkles,\n} from \"lucide-react\";\nimport \"./marketing.css\";\n\nconst features = [\n  {\n    icon: Network,\n    number: \"01\",\n    title: \"See the connections.\",\n    text: \"Explore imports, symbols, and candidate calls in an interactive map. Follow a dependency straight to its source.\",\n  },\n  {\n    icon: Search,\n    number: \"02\",\n    title: \"Find the meaning.\",\n    text: \"Search by name or intent. Ask questions and get source findings with citations you can actually inspect.\",\n  },\n  {\n    icon: GitBranch,\n    number: \"03\",\n    title: \"Understand the change.\",\n    text: \"Trace potential impact, inspect architecture, and review public pull requests with the codebase in context.\",\n  },\n];\n\nfunction RepositoryMap() {\n  return (\n    <div\n      className=\"product-preview\"\n      aria-label=\"Illustration of a Python repository dependency map\"\n    >\n      <div className=\"preview-toolbar\">\n        <span>\n          <span className=\"live-dot\" /> Repository explorer\n        </span>\n        <span className=\"preview-tag\">Illustrative workspace</span>\n      </div>\n      <div className=\"preview-body\">\n        <div className=\"preview-tree\">\n          <div>EXPLORER</div>\n          <p>\n            <GitBranch size={14} /> acme / toolkit\n          </p>\n          <span>⌄ &nbsp; src / toolkit</span>\n          <span className=\"tree-current\">&nbsp;&nbsp; __init__.py</span>\n          <span>&nbsp;&nbsp; serializer.py</span>\n          <span>&nbsp;&nbsp; signer.py</span>\n          <span>&nbsp;&nbsp; encoding.py</span>\n          <span>› &nbsp; tests</span>\n          <span> &nbsp; pyproject.toml</span>\n          <div className=\"tree-bottom\">\n            <span className=\"live-dot\" /> Source connected\n          </div>\n        </div>\n        <div className=\"preview-map\">\n          <div className=\"map-label\">\n            <Network size={14} /> Dependency map{\" \"}\n            <span>4 files · 3 connections</span>\n          </div>\n          <svg\n            viewBox=\"0 0 560 330\"\n            role=\"img\"\n            aria-label=\"The package imports serializer, which imports signer and encoding.\"\n          >\n            <defs>\n              <pattern\n                id=\"map-dots\"\n                width=\"20\"\n                height=\"20\"\n                patternUnits=\"userSpaceOnUse\"\n              >\n                <circle cx=\"1\" cy=\"1\" r=\"1\" fill=\"#d8dce8\" />\n              </pattern>\n              <linearGradient id=\"line-glow\">\n                <stop stopColor=\"#c5b9f9\" />\n                <stop offset=\"1\" stopColor=\"#7762e4\" />\n              </linearGradient>\n            </defs>\n            <rect width=\"560\" height=\"330\" fill=\"url(#map-dots)\" />\n            <g fill=\"none\" stroke=\"url(#line-glow)\" strokeWidth=\"2\">\n              <path\n                className=\"map-wire\"\n                d=\"M 140 165 C 185 165 170 105 225 105\"\n              />\n              <path\n                className=\"map-wire\"\n                d=\"M 345 105 C 395 105 355 220 410 220\"\n              />\n              <path\n                className=\"map-wire\"\n                d=\"M 285 128 C 285 180 220 170 220 220\"\n              />\n            </g>\n            {[\n              [30, 143, \"__init__.py\"],\n              [225, 83, \"serializer.py\"],\n              [160, 220, \"encoding.py\"],\n              [390, 220, \"signer.py\"],\n            ].map(([x, y, label], i) => (\n              <g\n                key={label}\n                className={`map-node map-node-${i}`}\n                transform={`translate(${x} ${y})`}\n              >\n                <rect\n                  width=\"130\"\n                  height=\"46\"\n                  rx=\"10\"\n                  fill={i === 1 ? \"#ede9ff\" : \"white\"}\n                  stroke={i === 1 ? \"#9e8be9\" : \"#d9deea\"}\n                />\n                <text\n                  x=\"15\"\n                  y=\"29\"\n                  fontSize=\"12\"\n                  fontFamily=\"monospace\"\n                  fill={i === 1 ? \"#6147c1\" : \"#4e5d76\"}\n                >\n                  {label}\n                </text>\n              </g>\n            ))}\n          </svg>\n          <div className=\"map-caption\">\n            <span>\n              <i /> Python module\n            </span>\n            <span>→ &nbsp; Import relationship</span>\n            <span>Explore the structure ↗</span>\n          </div>\n        </div>\n      </div>\n      <div className=\"preview-question\">\n        <Sparkles size={17} />\n        <span>Where does serialization happen?</span>\n        <span className=\"question-shortcut\">\n          Search the codebase <ArrowRight size={14} />\n        </span>\n      </div>\n    </div>\n  );\n}\n\nexport default function LandingPage() {\n  return (\n    <div className=\"marketing\">\n      <header className=\"site-header\">\n        <Link href=\"/\" className=\"site-brand\">\n          <span>\n            <Braces size={22} />\n          </span>\n          CodeAtlas\n        </Link>\n        <nav aria-label=\"Main navigation\">\n          <a href=\"#features\">Product</a>\n          <a href=\"#workflow\">How it works</a>\n          <a\n            href=\"https://github.com/stingingend/git-project\"\n            target=\"_blank\"\n            rel=\"noreferrer\"\n          >\n            GitHub <ArrowUpRight size={13} />\n          </a>\n        </nav>\n        <Link className=\"nav-cta\" href=\"/workspace\">\n          Open workspace <ArrowUpRight size={15} />\n        </Link>\n      </header>\n      <main>\n        <section className=\"landing-hero\">\n          <div className=\"hero-pill\">\n            <span className=\"live-dot\" /> A clearer view of your codebase\n          </div>\n          <h1>\n            Less searching.\n            <br />\n            More <span>understanding.</span>\n          </h1>\n          <p className=\"hero-copy\">\n            Turn a GitHub repository into a connected map of code.\n            <br className=\"desktop-break\" /> Explore the structure, find\n            answers, and see what a change could touch.\n          </p>\n          <div className=\"hero-actions\">\n            <Link className=\"landing-primary\" href=\"/workspace\">\n              Explore your repository <ArrowRight size={17} />\n            </Link>\n            <a\n              className=\"landing-secondary\"\n              href=\"https://github.com/stingingend/git-project\"\n              target=\"_blank\"\n              rel=\"noreferrer\"\n            >\n              <Github size={17} /> View the source\n            </a>\n          </div>\n          <div className=\"hero-notes\">\n            <span>\n              <ShieldCheck size={14} /> Python · JavaScript · TypeScript · C ·\n              C++\n            </span>\n            <span>\n              <Braces size={14} /> Source-backed insights\n            </span>\n          </div>\n          <RepositoryMap />\n        </section>\n        <section className=\"landing-features\" id=\"features\">\n          <div className=\"section-kicker\">FROM FILES TO THE BIG PICTURE</div>\n          <h2>\n            The context your editor\n            <br />\n            doesn’t give you.\n          </h2>\n          <div className=\"feature-grid\">\n            {features.map(({ icon: Icon, number, title, text }) => (\n              <article key={number}>\n                <div className=\"feature-top\">\n                  <span>\n                    <Icon size={21} />\n                  </span>\n                  <small>{number}</small>\n                </div>\n                <h3>{title}</h3>\n                <p>{text}</p>\n              </article>\n            ))}\n          </div>\n        </section>\n        <section className=\"landing-workflow\" id=\"workflow\">\n          <div>\n            <div className=\"section-kicker\">BUILT AROUND YOUR CODE</div>\n            <h2>\n              A new repository.\n              <br />A familiar starting point.\n            </h2>\n            <p>\n              Move from an unfamiliar project to the files that matter, with the\n              original source always one click away.\n            </p>\n            <Link href=\"/workspace\">\n              Start exploring <ArrowRight size={16} />\n            </Link>\n          </div>\n          <ol>\n            {[\n              [\n                \"Connect\",\n                \"Paste a public GitHub repository URL. CodeAtlas collects its supported source without running it.\",\n              ],\n              [\n                \"Map\",\n                \"Index definitions and relationships, then explore files in a connected workspace.\",\n              ],\n              [\n                \"Investigate\",\n                \"Search symbols, trace dependencies, or build a semantic index for source-cited questions.\",\n              ],\n            ].map(([title, text], i) => (\n              <li key={title}>\n                <span>0{i + 1}</span>\n                <div>\n                  <h3>{title}</h3>\n                  <p>{text}</p>\n                </div>\n              </li>\n            ))}\n          </ol>\n        </section>\n        <section className=\"landing-close\">\n          <div className=\"section-kicker\">MAKE SENSE OF WHAT’S NEXT</div>\n          <h2>\n            Your code has a story.\n            <br />\n            See how it connects.\n          </h2>\n          <Link className=\"landing-primary\" href=\"/workspace\">\n            Open your workspace <ArrowRight size={17} />\n          </Link>\n          <p>A personal workspace for exploring public repositories.</p>\n        </section>\n      </main>\n      <footer className=\"site-footer\">\n        <Link href=\"/\" className=\"site-brand\">\n          <Braces size={21} />\n          CodeAtlas\n        </Link>\n        <span>Find your way through the code.</span>\n        <a href=\"https://github.com/stingingend/git-project\">\n          Source on GitHub <ArrowUpRight size={14} />\n        </a>\n      </footer>\n    </div>\n  );\n}\n","commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","github_url":"https://github.com/stingingend/codeatlas/blob/42dd9d487d4fe9ede7f9129bfa90969a129f5511/frontend/app/page.tsx","parsing":{"file_id":70,"has_parse_errors":false,"symbol_count":5},"symbols":{"items":[{"id":1028,"file_id":70,"name":"import Link from \"next/link\";","qualified_name":"frontend/app/page.tsx::import Link from \"next/link\";","parent_qualified_name":null,"symbol_type":"import","start_line":1,"end_line":1,"signature":"import Link from \"next/link\";"},{"id":1029,"file_id":70,"name":"import {\n  ArrowRight,\n  ArrowUpRight,\n  Braces,\n  GitBranch,\n  Github,\n  Network,\n  Search,\n  ShieldCheck,\n  Sparkles,\n} from \"lucide-react\";","qualified_name":"frontend/app/page.tsx::import {\n  ArrowRight,\n  ArrowUpRight,\n  Braces,\n  GitBranch,\n  Github,\n  Network,\n  Search,\n  ShieldCheck,\n  Sparkles,\n} from \"lucide-react\";","parent_qualified_name":null,"symbol_type":"import","start_line":2,"end_line":12,"signature":"import {\n  ArrowRight,\n  ArrowUpRight,\n  Braces,\n  GitBranch,\n  Github,\n  Network,\n  Search,\n  ShieldCheck,\n  Sparkles,\n} from \"lucide-react\";"},{"id":1030,"file_id":70,"name":"import \"./marketing.css\";","qualified_name":"frontend/app/page.tsx::import \"./marketing.css\";","parent_qualified_name":null,"symbol_type":"import","start_line":13,"end_line":13,"signature":"imp