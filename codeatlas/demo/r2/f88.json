{"detail":{"file":{"id":88,"repository_id":2,"path":"frontend/lib/workspace-access.ts","language":"TypeScript","content_hash":"5d8962b901542de7b8f70118d4f9e0f298d7cb4df3a0227f6340d05111d760a9","line_count":39},"source":"import { createHash, timingSafeEqual } from \"node:crypto\";\n\nexport function workspaceAccess(\n  authorization: string | null,\n  env: Record<string, string | undefined>,\n): \"allow\" | \"challenge\" | \"unconfigured\" {\n  const user = env.WORKSPACE_USERNAME;\n  const password = env.WORKSPACE_PASSWORD;\n  const required = env.WORKSPACE_AUTH_REQUIRED === \"1\";\n  if (!user && !password && !required) return \"allow\";\n  if (!user || !password || user.includes(\":\") || password.length < 16)\n    return \"unconfigured\";\n  if (\n    !authorization ||\n    authorization.length > 4096 ||\n    !/^Basic [A-Za-z0-9+/]+={0,2}$/i.test(authorization)\n  )\n    return \"challenge\";\n  const supplied = Buffer.from(authorization.slice(6), \"base64\").toString(\n    \"utf8\",\n  );\n  const digest = (value: string) => createHash(\"sha256\").update(value).digest();\n  return timingSafeEqual(digest(supplied), digest(`${user}:${password}`))\n    ? \"allow\"\n    : \"challenge\";\n}\n\nexport function crossSiteMutation(\n  method: string,\n  origin: string | null,\n  requestOrigin: string,\n  fetchSite: string | null,\n) {\n  return (\n    ![\"GET\", \"HEAD\", \"OPTIONS\"].includes(method) &&\n    (fetchSite === \"cross-site\" ||\n      (origin !== null && origin !== requestOrigin))\n  );\n}\n","commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","github_url":"https://github.com/stingingend/codeatlas/blob/42dd9d487d4fe9ede7f9129bfa90969a129f5511/frontend/lib/workspace-access.ts","parsing":{"file_id":88,"has_parse_errors":false,"symbol_count":4},"symbols":{"items":[{"id":1189,"file_id":88,"name":"import { createHash, timingSafeEqual } from \"node:crypto\";","qualified_name":"frontend/lib/workspace-access.ts::import { createHash, timingSafeEqual } from \"node