{"detail":{"file":{"id":58,"repository_id":2,"path":"backend/tests/test_migrations.py","language":"Python","content_hash":"d2fee5d0059ce366fc78ee885fc2b1054a64b090f7d9d236bbc6a92cbef5de09","line_count":47},"source":"from datetime import datetime, timezone\n\nimport pytest\nfrom sqlalchemy import inspect, text\n\nfrom app.database import create_database\nfrom app.migrations import upgrade_database\nfrom app.migrations.baseline import Base\n\n\ndef test_fresh_and_repeat_upgrade(database_url):\n    engine, _ = create_database(database_url)\n    try:\n        upgrade_database(engine)\n        upgrade_database(engine)\n        with engine.connect() as connection:\n            assert connection.scalar(text(\"SELECT version_num FROM alembic_version\")) == \"005_pull_requests\"\n        assert \"ix_index_jobs_repository_created\" in {index[\"name\"] for index in inspect(engine).get_indexes(\"index_jobs\")}\n    finally:\n        engine.dispose()\n\n\ndef test_adopts_previous_database_without_changing_records(database_url):\n    engine, _ = create_database(database_url)\n    try:\n        Base.metadata.create_all(engine)\n        with engine.begin() as connection:\n            connection.execute(Base.metadata.tables[\"repositories\"].insert(), dict(id=71,\n                github_url=\"https://github.com/example/legacy\", owner=\"example\", name=\"legacy\",\n                status=\"registered\", created_at=datetime.now(timezone.utc)))\n        upgrade_database(engine)\n        with engine.connect() as connection:\n            assert connection.scalar(text(\"SELECT name FROM repositories WHERE id=71\")) == \"legacy\"\n    finally:\n        engine.dispose()\n\n\ndef test_incompatible_database_is_not_stamped(database_url):\n    engine, _ = create_database(database_url)\n    try:\n        with engine.begin() as connection:\n            connection.execute(text(\"CREATE TABLE repositories (id INTEGER PRIMARY KEY)\"))\n        with pytest.raises(RuntimeError, match=\"incompatible table repositories\"):\n            upgrade_database(engine)\n        assert \"repository_snapshots\" not in inspect(engine).get_table_names()\n    finally:\n        engine.dispose()\n","commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","github_url":"https://github.com/stingingend/codeatlas/blob/42dd9d487d4fe9ede7f9129bfa90969a129f5511/backend/tests/test_migrations.py","parsing":{"file_id":58,"has_parse_errors":false,"symbol_count":9},"symbols":{"items":[{"id":861,"file_id":58,"name":"from datetime import datetime, timezone","qualified_name":"backend/tests/test_migrations.py::import@1:0","parent_qualified_name":null,"symbol_type":"import","start_line":1,"end_line":1,"signature":"from datetime import datetime, timezone"},{"id":862,"file_id":58,"name":"import pytest","qualified_name":"backend/tests/test_migrations.py::import@3:0","parent_qualified_name":null,"symbol_type":"import","start_line":3,"end_line":3,"signature":"import pytest"},{"id":863,"file_id":58,"name":"from sqlalchemy import inspect, text","qualified_name":"backend/tests/test_migrations.py::import@4:0","parent_qualified_name":null,"symbol_type":"import","start_line":4,"end_line":4,"signature":"from sqlalchemy import inspect, text"},{"id":864,"file_id":58,"name":"from app.database import create_database","qualified_name":"backend/tests/test_migrations.py::import@6:0","parent_qualified_name":null,"symbol_type":"import","start_line":6,"end_line":6,"signature":"from app.database import create_database"},{"id":865,"file_id":58,"name":"from app.migrations import upgrade_database","qualified_name":"backend/tests/test_migrations.py::import@7:0","parent_qualified_name":null,"symbol_type":"import","start_line":7,"end_line":7,"signature":"from app.migrations import upgrade_database"},{"id":866,"file_id":58,"name":"from app.migrations.baseline import Base","qualified_name":"backend/tests/test_migrations.py::import@8:0","parent_qualified_name":null,"symbol_type":"import","start_line":8,"end_line":8,"signature":"