{"detail":{"file":{"id":84,"repository_id":2,"path":"frontend/lib/graph-layout.ts","language":"TypeScript","content_hash":"8f9e8905f6065d00bddc9381ead67ba8ab95fc558b753071f2441e6091a5cdd8","line_count":32},"source":"import type { DependencyGraph } from \"./types\";\n\nexport const GRAPH_WIDTH = 760;\nexport const NODE_WIDTH = 194;\nexport const NODE_HEIGHT = 72;\n\nexport function layoutGraph(graph: DependencyGraph) {\n  const incoming = new Set(graph.edges.filter(edge => edge.target === graph.file_id).map(edge => edge.source));\n  const outgoing = new Set(graph.edges.filter(edge => edge.source === graph.file_id).map(edge => edge.target));\n  const left = graph.nodes.filter(node => node.id !== graph.file_id && !outgoing.has(node.id));\n  const right = graph.nodes.filter(node => node.id !== graph.file_id && outgoing.has(node.id));\n  const height = Math.max(250, Math.max(left.length, right.length) * 92 + 100);\n  const positions = new Map<number, { x: number; y: number }>();\n  positions.set(graph.file_id, { x: 283, y: (height - NODE_HEIGHT) / 2 });\n  for (const [nodes, x] of [[left, 14], [right, 552]] as const) {\n    nodes.forEach((node, index) => positions.set(node.id, { x, y: 64 + index * 92 }));\n  }\n  const edges = graph.edges.flatMap(edge => {\n    const source = positions.get(edge.source), target = positions.get(edge.target);\n    if (!source || !target || edge.source === edge.target) return [];\n    const reverse = graph.edges.some(other => other.source === edge.target && other.target === edge.source);\n    const offset = reverse ? (edge.source === graph.file_id ? 9 : -9) : 0;\n    const x1 = source.x + (source.x < target.x ? NODE_WIDTH : 0);\n    const x2 = target.x + (source.x < target.x ? 0 : NODE_WIDTH);\n    const y1 = source.y + NODE_HEIGHT / 2 + offset;\n    const y2 = target.y + NODE_HEIGHT / 2 + offset;\n    const mid = (x1 + x2) / 2;\n    return [{ ...edge, path: `M ${x1} ${y1} C ${mid} ${y1}, ${mid} ${y2}, ${x2} ${y2}`,\n      labelX: mid, labelY: (y1 + y2) / 2 - 5 }];\n  });\n  return { height, positions, edges, incoming, outgoing };\n}\n","commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","github_url":"https://github.com/stingingend/codeatlas/blob/42dd9d487d4fe9ede7f9129bfa90969a129f5511/frontend/lib/graph-layout.ts","parsing":{"file_id":84,"has_parse_errors":false,"symbol_count":2},"symbols":{"items":[{"id":1153,"file_id":84,"name":"import type { DependencyGraph } from \"./types\";","qualified_name":"frontend/lib/graph-layout.ts::import type { DependencyGraph } from \"./types\";","parent_qualified_name":null,"symbol_type":"import","start_line":1,"end_line":1,"signature":"import type { DependencyGraph } from \"./types\";"},{"id":1154,"file_id":84,"name":"layoutGraph","qualified_name":"frontend/lib/graph-layout.ts::layoutGraph","parent_qualified_name":null,"symbol_type":"function","start_line":7,"end_line":32,"signature":"function layoutGraph(graph: DependencyGraph)"}],"total":2,"limit":500,"offset":0}},"graph":{"file_id":84,"ready":true,"commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","total_neighbors":4,"unresolved_imports":0,"self_imports":0,"nodes":[{"id":84,"path":"frontend/lib/graph-layout.ts"},{"id":75,"path":"frontend/components/dependency-graph.tsx"},{"id":85,"path":"frontend/lib/graph-motion.ts"},{"id":87,"path":"frontend/lib/types.ts"},{"id":95,"path":"frontend/tests/graph.test.mjs"}],"edges":[{"source":75,"target":84,"count":1},{"source":84,"target":87,"count":1},{"source":85,"target":84,"count":1},{"source":95,"target":84,"count":1}]},"calls":{"file_id":84,"ready":true,"commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","has_parse_errors":false,"summary":{"total":20,"candidates":0,"ambiguous":0,"unresolved":20},"items":[{"id":4476,"expression":"Set","call_type":"direct","start_line":8,"end_line":8,"column":20,"resolution":"unresolved","caller":{"id":1154,"file_id":84,"name":"layoutGraph","qualified_name":"frontend/lib/graph-layout.ts::layoutGraph","parent_qualified_name":null,