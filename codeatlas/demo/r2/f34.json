{"detail":{"file":{"id":34,"repository_id":2,"path":"backend/app/migrations/versions/v004_semantic.py","language":"Python","content_hash":"98b45ed8f693b313d8cc23ee9bd237c618a9575f36ac4393e3ff8f7f70c58479","line_count":41},"source":"\"\"\"Portable embedding cache with optional native pgvector storage.\"\"\"\nfrom alembic import op\nimport sqlalchemy as sa\n\nrevision = \"004_semantic\"\ndown_revision = \"003_call_origins\"\nbranch_labels = depends_on = None\n\n\ndef upgrade():\n    op.create_table(\"search_documents\",\n        sa.Column(\"id\", sa.Integer, primary_key=True),\n        sa.Column(\"repository_id\", sa.Integer, sa.ForeignKey(\"repositories.id\"), nullable=False),\n        sa.Column(\"file_id\", sa.Integer, sa.ForeignKey(\"source_files.id\"), nullable=False),\n        sa.Column(\"symbol_id\", sa.Integer, sa.ForeignKey(\"symbols.id\"), nullable=True),\n        sa.Column(\"unit_key\", sa.String(80), nullable=False),\n        sa.Column(\"content_hash\", sa.String(64), nullable=False),\n        sa.Column(\"model\", sa.String(200), nullable=False),\n        sa.Column(\"embedding\", sa.Text, nullable=False),\n        sa.UniqueConstraint(\"file_id\", \"unit_key\"))\n    op.create_index(\"ix_search_documents_repository_id\", \"search_documents\", [\"repository_id\"])\n    op.create_index(\"ix_search_documents_file_id\", \"search_documents\", [\"file_id\"])\n    op.create_table(\"semantic_snapshots\",\n        sa.Column(\"repository_id\", sa.Integer, sa.ForeignKey(\"repositories.id\"), primary_key=True),\n        sa.Column(\"commit_sha\", sa.String(40), nullable=False),\n        sa.Column(\"model\", sa.String(200), nullable=False),\n        sa.Column(\"document_count\", sa.Integer, nullable=False),\n        sa.Column(\"indexed_at\", sa.DateTime(timezone=True), nullable=False))\n    connection = op.get_bind()\n    if connection.dialect.name == \"postgresql\" and connection.scalar(sa.text(\n            \"SELECT EXISTS(SELECT 1 FROM pg_available_extensions WHERE name='vector')\")):\n        op.execute(\"CREATE EXTENSION IF NOT EXISTS vector WITH SCHEMA public\")\n        op.execute(\"CREATE TABLE search_vectors (document_id INTEGER PRIMARY KEY REFERENCES search_documents(id) \"\n                   \"ON DELETE CASCADE, embedding public.vector(256) NOT NULL)\")\n\n\ndef downgrade():\n    if op.get_bind().dialect.name == \"postgresql\":\n        op.execute(\"DROP TABLE IF EXISTS search_vectors\")\n    op.drop_table(\"semantic_snapshots\")\n    op.drop_table(\"search_documents\")\n","commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","github_url":"https://github.com/stingingend/codeatlas/blob/42dd9d487d4fe9ede7f9129bfa90969a129f5511/backend/app/migrations/versions/v004_semantic.py","parsing":{"file_id":34,"has_parse_errors":false,"symbol_count":4},"symbols":{"items":[{"id":497,"file_id":34,"name":"from alembic import op","qualified_name":"backend/app/migrations/versions/v004_semantic.py::import@2:0","parent_qualified_name":null,"symbol_type":"import","start_line":2,"end_line":2,"signature":"from alembic import op"},{"id":498,"file_id":34,"name":"import sqlalchemy as sa","qualified_name":"backend/app/migrations/versions/v004_semantic.py::import@3:0","parent_qualified_name":null,"symbol_type":"import","start_line":3,"end_line":3,"signature":"import sqlalchemy as sa"},{"id":499,"file_id":34,"name":"upgrade","qualified_name":"backend/app/migrations/versions/v004_semantic.py::upgrade","parent_qualified_name":null,"symbol_type":"function","start_line":10,"end_line":34,"signature":"def upgrade()"},{"id":500,"file_id":34,"name":"downgrade","qualified_name":"backend/app/migrations/versions/v004_semantic.py::downgrade","parent_qualified_name":null,"symbol_type":"function","start_line":37,"end_line":41,"signature":"def downgrade()"}],"total":4,"limit":500,"offset":0}},"graph":{"file_id":34,"ready":true,"commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","total_neighbors":0,"unresolved_imports":2,"self_imports":0,"nodes":[{"id":34,"pa