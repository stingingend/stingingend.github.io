{"detail":{"file":{"id":97,"repository_id":2,"path":"frontend/tests/jobs.test.mjs","language":"JavaScript","content_hash":"ff37a1c18d994c7a546f6f8a56353b9a10c7d16e8fabcc2fd29f7b2e72dd1e0f","line_count":40},"source":"import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { activeJob, createApi, startIndexJob } from \"../lib/api.ts\";\n\nconst repo = { id: 7, github_url: \"https://github.com/example/demo\" };\nconst job = { id: \"durable-job\", repository_id: 7, status: \"queued\", stage: \"queued\" };\nconst json = body => new Response(JSON.stringify(body));\n\ntest(\"background indexing registers and submits without synchronous ingestion or parsing\", async () => {\n  const paths = [];\n  const api = createApi(async (path, options) => {\n    paths.push(path);\n    assert.equal(options.method, \"POST\");\n    return json(path === \"/api/repositories\" ? repo : job);\n  });\n  assert.deepEqual(await startIndexJob(repo.github_url, api), { repository: repo, job });\n  assert.deepEqual(paths, [\"/api/repositories\", \"/api/repositories/7/jobs\"]);\n});\n\ntest(\"existing repositories reconnect to a durable job\", async () => {\n  const api = createApi(async (path, options) => {\n    if (path === \"/api/repositories\" && options.method === \"POST\") {\n      return new Response(JSON.stringify({ detail: \"Already registered\" }), { status: 409 });\n    }\n    if (path === \"/api/repositories\") return json([repo]);\n    assert.equal(path, \"/api/repositories/7/jobs\");\n    return json({ ...job, status: \"running\" });\n  });\n  assert.equal((await startIndexJob(\"https://github.com/EXAMPLE/demo.git\", api)).job.status, \"running\");\n});\n\ntest(\"job polling and recent history use separate read endpoints\", async () => {\n  const paths = [];\n  const api = createApi(async path => { paths.push(path); return json(job); });\n  await api.job(\"id/with spaces\");\n  await api.jobs();\n  assert.deepEqual(paths, [\"/api/jobs/id%2Fwith%20spaces\", \"/api/jobs?limit=10\"]);\n  for (const status of [\"queued\", \"running\"]) assert.ok(activeJob({ status }));\n  for (const status of [\"succeeded\", \"failed\", \"interrupted\"]) assert.equal(activeJob({ status }), false);\n});\n","commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","github_url":"https://github.com/stingingend/codeatlas/blob/42dd9d487d4fe9ede7f9129bfa90969a129f5511/frontend/tests/jobs.test.mjs","parsing":{"file_id":97,"has_parse_errors":false,"symbol_count":4},"symbols":{"items":[{"id":1219,"file_id":97,"name":"import assert from \"node:assert/strict\";","qualified_name":"frontend/tests/jobs.test.mjs::import assert from \"node:assert/strict\";","parent_qualified_name":null,"symbol_type":"import","start_line":1,"end_line":1,"signature":"import assert from \"node:assert/strict\";"},{"id":1220,"file_id":97,"name":"import { test } from \"node:test\";","qualified_name":"frontend/tests/jobs.test.mjs::import { test } from \"node:test\";","parent_qualified_name":null,"symbol_type":"import","start_line":2,"end_line":2,"signature":"import { test } from \"node:test\";"},{"id":1221,"file_id":97,"name":"import { activeJob, createApi, startIndexJob } from \"../lib/api.ts\";","qualified_name":"frontend/tests/jobs.test.mjs::import { activeJob, createApi, startIndexJob } from \"../lib/api.ts\";","parent_qualified_name":null,"symbol_type":"import","start_line":3,"end_line":3,"signature":"import { activeJob, createApi, startIndexJob } from \"../lib/api.ts\";"},{"id":1222,"file_id":97,"name":"json","qualified_name":"frontend/tests/jobs.test.mjs::json","parent_qualified_name":null,"symbol_type":"function","start_line":7,"end_line":7,"signature":"body =>"}],"total":4,"limit":500,"offset":0}},"graph":{"file_id":97,"ready":true,"commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","total_neighbors":1,"unresolved_imports":2,"self_imports":0,"nodes":[{"id":97,"path":"frontend/tests/jobs.test.mjs"},{"id":83,"path":"frontend/lib/api.ts"}],"edges":[{"source":97,"target