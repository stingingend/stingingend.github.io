{"detail":{"file":{"id":50,"repository_id":2,"path":"backend/tests/test_cross_calls.py","language":"Python","content_hash":"77144b961b2ea93542d5bc9a3c3a9705d622a512e90b95a8f0c0cfaf0b8c645f","line_count":41},"source":"from sqlalchemy import select\n\nfrom app.models import SourceFile\nfrom test_incremental import commit, index, saved\nfrom test_ingestion import git_repository, local_clone, register\n\n\ndef test_explicit_import_aliases_and_receiver_methods(client, ingested_repository):\n    with client.app.state.sessions() as session:\n        file = session.scalar(select(SourceFile).where(SourceFile.path == \"app.py\"))\n        file.source = \"from helpers import work as go\\nimport helpers as h\\nclass A:\\n    def run(self):\\n        go(); h.work(); self.helper()\\n    def helper(self): pass\\n\"\n        file_id = file.id\n        session.add(SourceFile(repository_id=ingested_repository, path=\"helpers.py\", content_hash=\"d\" * 64,\n            line_count=1, source=\"def work(): return 1\\n\"))\n        session.commit()\n    prefix = f\"/repositories/{ingested_repository}\"\n    assert client.post(prefix + \"/parse\").status_code == 200\n    calls = client.get(prefix + f\"/files/{file_id}/calls\").json()[\"items\"]\n    assert [call[\"target\"][\"name\"] for call in calls] == [\"work\", \"work\", \"helper\"]\n    assert all(call[\"resolution\"] == \"candidate\" for call in calls)\n\n\ndef test_unchanged_imported_calls_relink_after_target_changes(client, local_clone, git_repository):\n    (git_repository / \"src/app.py\").write_text(\"from helper import work\\ndef run(): return work()\\n\")\n    (git_repository / \"src/helper.py\").write_text(\"def work(): return 1\\n\")\n    commit(git_repository, \"imported call\")\n    repo = register(client)\n    prefix = f\"/repositories/{repo}\"\n    index(client, prefix)\n    before = saved(client)[\"src/app.py\"]\n    url = prefix + f\"/files/{before[0]}/calls\"\n    assert client.get(url).json()[\"items\"][0][\"target\"][\"name\"] == \"work\"\n    (git_repository / \"src/helper.py\").write_text(\"def work(): return 2\\ndef work(): return 3\\n\")\n    commit(git_repository, \"ambiguous target\")\n    index(client, prefix)\n    assert client.get(url).json()[\"items\"][0][\"resolution\"] == \"ambiguous\"\n    (git_repository / \"src/helper.py\").unlink()\n    commit(git_repository, \"remove target\")\n    index(client, prefix)\n    assert client.get(url).json()[\"items\"][0][\"resolution\"] == \"unresolved\"\n    assert saved(client)[\"src/app.py\"] == before\n","commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","github_url":"https://github.com/stingingend/codeatlas/blob/42dd9d487d4fe9ede7f9129bfa90969a129f5511/backend/tests/test_cross_calls.py","parsing":{"file_id":50,"has_parse_errors":false,"symbol_count":6},"symbols":{"items":[{"id":741,"file_id":50,"name":"from sqlalchemy import select","qualified_name":"backend/tests/test_cross_calls.py::import@1:0","parent_qualified_name":null,"symbol_type":"import","start_line":1,"end_line":1,"signature":"from sqlalchemy import select"},{"id":742,"file_id":50,"name":"from app.models import SourceFile","qualified_name":"backend/tests/test_cross_calls.py::import@3:0","parent_qualified_name":null,"symbol_type":"import","start_line":3,"end_line":3,"signature":"from app.models import SourceFile"},{"id":743,"file_id":50,"name":"from test_incremental import commit, index, saved","qualified_name":"backend/tests/test_cross_calls.py::import@4:0","parent_qualified_name":null,"symbol_type":"import","start_line":4,"end_line":4,"signature":"from test_incremental import commit, index, saved"},{"id":744,"file_id":50,"name":"from test_ingestion import git_repository, local_clone, register","qualified_name":"backend/tests/test_cross_calls.py::import@5:0","parent_qualified_name":null,"symbol_type":"import","start_line":5,"end_line":5,"signature":"from test_ingestion import git_repository, local_clone, register"},{"id":745,"file_id":50,"name":"test_explici