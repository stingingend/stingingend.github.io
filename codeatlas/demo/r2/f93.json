{"detail":{"file":{"id":93,"repository_id":2,"path":"frontend/tests/calls.test.mjs","language":"JavaScript","content_hash":"084b355979d5a71c5d1f212ee5db9ac7121e37a4811bcb8991202ca2f7eeda32","line_count":23},"source":"import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { createApi } from \"../lib/api.ts\";\n\ntest(\"call requests include scope, resolution filter, and page offset\", async () => {\n  const api = createApi(async path => {\n    const url = new URL(path, \"http://localhost\");\n    assert.equal(url.pathname, \"/api/repositories/3/files/9/calls\");\n    assert.equal(url.searchParams.get(\"resolution\"), \"candidate\");\n    assert.equal(url.searchParams.get(\"offset\"), \"30\");\n    assert.equal(url.searchParams.get(\"limit\"), \"30\");\n    return new Response(JSON.stringify({ items: [], total: 0 }));\n  });\n  await api.calls(3, 9, \"candidate\", 30);\n});\n\ntest(\"unfiltered call pages omit the optional resolution parameter\", async () => {\n  const api = createApi(async path => {\n    assert.equal(new URL(path, \"http://localhost\").searchParams.has(\"resolution\"), false);\n    return new Response(JSON.stringify({ items: [], ready: false }));\n  });\n  assert.equal((await api.calls(3, 9)).ready, false);\n});\n","commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","github_url":"https://github.com/stingingend/codeatlas/blob/42dd9d487d4fe9ede7f9129bfa90969a129f5511/frontend/tests/calls.test.mjs","parsing":{"file_id":93,"has_parse_errors":false,"symbol_count":3},"symbols":{"items":[{"id":1206,"file_id":93,"name":"import assert from \"node:assert/strict\";","qualified_name":"frontend/tests/calls.test.mjs::import assert from \"node:assert/strict\";","parent_qualified_name":null,"symbol_type":"import","start_line":1,"end_line":1,"signature":"import assert from \"node:assert/strict\";"},{"id":1207,"file_id":93,"name":"import { test } from \"node:test\";","qualified_name":"frontend/tests/calls.test.mjs::import { test } 