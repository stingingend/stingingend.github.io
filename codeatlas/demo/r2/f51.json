{"detail":{"file":{"id":51,"repository_id":2,"path":"backend/tests/test_database.py","language":"Python","content_hash":"1c387482b7082c9b12c02810a5fe67632054878b1355a096d866fc1ce074972f","line_count":30},"source":"from sqlalchemy import event\nfrom sqlalchemy.exc import OperationalError\n\nfrom app.database import create_database\n\n\ndef test_readiness_checks_database_and_does_not_leak_failure(client):\n    assert client.get(\"/ready\").json() == {\"status\": \"ready\"}\n    engine = client.app.state.sessions.kw[\"bind\"]\n    def unavailable(*args):\n        raise OperationalError(\"private connection details\", {}, Exception(\"secret\"))\n    event.listen(engine, \"before_cursor_execute\", unavailable)\n    try:\n        response = client.get(\"/ready\")\n        assert response.status_code == 503\n        assert response.json() == {\"detail\": \"Database unavailable.\"}\n        assert client.get(\"/health\").json() == {\"status\": \"ok\"}\n    finally:\n        event.remove(engine, \"before_cursor_execute\", unavailable)\n\n\ndef test_postgres_urls_select_psycopg_without_connecting():\n    import pytest\n    pytest.importorskip(\"psycopg\")\n    for scheme in (\"postgres\", \"postgresql\", \"postgresql+psycopg\"):\n        engine, _ = create_database(f\"{scheme}://user:password@localhost/db\")\n        try:\n            assert engine.url.drivername == \"postgresql+psycopg\"\n        finally:\n            engine.dispose()\n","commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","github_url":"https://github.com/stingingend/codeatlas/blob/42dd9d487d4fe9ede7f9129bfa90969a129f5511/backend/tests/test_database.py","parsing":{"file_id":51,"has_parse_errors":false,"symbol_count":7},"symbols":{"items":[{"id":747,"file_id":51,"name":"from sqlalchemy import event","qualified_name":"backend/tests/test_database.py::import@1:0","parent_qualified_name":null,"symbol_type":"import","start_line":1,"end_line":1,"signature":"from sqlalchemy import event"},{"id":748,"file_id":51,"