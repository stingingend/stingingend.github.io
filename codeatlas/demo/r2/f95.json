{"detail":{"file":{"id":95,"repository_id":2,"path":"frontend/tests/graph.test.mjs","language":"JavaScript","content_hash":"58360e4e22d4dbcaf32e9deda7d5df4d1f19e5780f496d68b4c59fb147a27002","line_count":39},"source":"import assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { createApi } from \"../lib/api.ts\";\nimport { layoutGraph, NODE_HEIGHT, NODE_WIDTH } from \"../lib/graph-layout.ts\";\n\nconst graph = { file_id: 1, nodes: [{ id: 1, path: \"center.py\" }, { id: 2, path: \"in.py\" }, { id: 3, path: \"out.py\" }],\n  edges: [{ source: 2, target: 1, count: 1 }, { source: 1, target: 3, count: 3 }, { source: 3, target: 1, count: 1 }] };\n\ntest(\"graph lays importers left, dependencies right, and preserves reverse arrows\", () => {\n  const layout = layoutGraph(graph);\n  assert.ok(layout.positions.get(2).x < layout.positions.get(1).x);\n  assert.ok(layout.positions.get(3).x > layout.positions.get(1).x);\n  assert.equal(layout.edges.length, 3);\n  assert.notEqual(layout.edges[1].path, layout.edges[2].path);\n  assert.equal(layout.edges[1].count, 3);\n  for (const position of layout.positions.values()) {\n    assert.ok(position.y >= 0 && position.y + NODE_HEIGHT <= layout.height);\n    assert.ok(position.x >= 0 && position.x + NODE_WIDTH <= 760);\n  }\n});\n\ntest(\"large neighborhoods allocate separate rows and empty graphs keep a center\", () => {\n  const nodes = [{ id: 1, path: \"center.py\" }, ...Array.from({ length: 12 }, (_, index) => ({ id: index + 2, path: `${index}.py` }))];\n  const layout = layoutGraph({ file_id: 1, nodes, edges: nodes.slice(1).map(node => ({ source: node.id, target: 1, count: 1 })) });\n  const positions = nodes.slice(1).map(node => layout.positions.get(node.id).y);\n  assert.equal(new Set(positions).size, 12);\n  assert.ok(Math.max(...positions) + NODE_HEIGHT < layout.height);\n  const empty = layoutGraph({ file_id: 1, nodes: [nodes[0]], edges: [] });\n  assert.equal(empty.positions.size, 1);\n  assert.deepEqual(empty.edges, []);\n});\n\ntest(\"graph API scopes requests by repository and file\", async () => {\n  const api = createApi(async path => {\n    assert.equal(path, \"/api/repositories/7/files/11/graph\");\n    return new Response(JSON.stringify({ nodes: [], edges: [] }));\n  });\n  assert.deepEqual(await api.graph(7, 11), { nodes: [], edges: [] });\n});\n","commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","github_url":"https://github.com/stingingend/codeatlas/blob/42dd9d487d4fe9ede7f9129bfa90969a129f5511/frontend/tests/graph.test.mjs","parsing":{"file_id":95,"has_parse_errors":false,"symbol_count":4},"symbols":{"items":[{"id":1212,"file_id":95,"name":"import assert from \"node:assert/strict\";","qualified_name":"frontend/tests/graph.test.mjs::import assert from \"node:assert/strict\";","parent_qualified_name":null,"symbol_type":"import","start_line":1,"end_line":1,"signature":"import assert from \"node:assert/strict\";"},{"id":1213,"file_id":95,"name":"import { test } from \"node:test\";","qualified_name":"frontend/tests/graph.test.mjs::import { test } from \"node:test\";","parent_qualified_name":null,"symbol_type":"import","start_line":2,"end_line":2,"signature":"import { test } from \"node:test\";"},{"id":1214,"file_id":95,"name":"import { createApi } from \"../lib/api.ts\";","qualified_name":"frontend/tests/graph.test.mjs::import { createApi } from \"../lib/api.ts\";","parent_qualified_name":null,"symbol_type":"import","start_line":3,"end_line":3,"signature":"import { createApi } from \"../lib/api.ts\";"},{"id":1215,"file_id":95,"name":"import { layoutGraph, NODE_HEIGHT, NODE_WIDTH } from \"../lib/graph-layout.ts\";","qualified_name":"frontend/tests/graph.test.mjs::import { layoutGraph, NODE_HEIGHT, NODE_WIDTH } from \"../lib/graph-layout.ts\";","parent_qualified_name":null,"symbol_type":"import","start_line":4,"end_line":4,"signature":"import { layoutGraph, NODE_HEIGHT, NODE_WIDTH } from \"../lib/graph-layout.ts\";"}],"total":4,"limit":500,"offset":