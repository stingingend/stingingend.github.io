{"detail":{"file":{"id":91,"repository_id":2,"path":"frontend/proxy.ts","language":"TypeScript","content_hash":"17ebbddbfcd7f315cf57a7e61024c094e206469783d6996b0774fe09e10ba86e","line_count":60},"source":"import { NextRequest, NextResponse } from \"next/server\";\nimport { crossSiteMutation, workspaceAccess } from \"./lib/workspace-access\";\n\nfunction forward(request: NextRequest) {\n  const headers = new Headers(request.headers);\n  headers.delete(\"authorization\");\n  const response = NextResponse.next({ request: { headers } });\n  response.headers.set(\"Cache-Control\", \"private, no-store\");\n  response.headers.set(\"X-Robots-Tag\", \"noindex, nofollow\");\n  return response;\n}\n\nexport function proxy(request: NextRequest) {\n  // This is the only anonymous API endpoint: a minimal database readiness check.\n  if (\n    request.nextUrl.pathname === \"/api/ready\" &&\n    [\"GET\", \"HEAD\"].includes(request.method)\n  )\n    return forward(request);\n  const access = workspaceAccess(\n    request.headers.get(\"authorization\"),\n    process.env,\n  );\n  if (access === \"unconfigured\")\n    return new NextResponse(\"Workspace access is not configured.\", {\n      status: 503,\n      headers: { \"Cache-Control\": \"no-store\" },\n    });\n  if (access === \"challenge\")\n    return new NextResponse(\"Sign in to your CodeAtlas workspace.\", {\n      status: 401,\n      headers: {\n        \"WWW-Authenticate\":\n          'Basic realm=\"CodeAtlas workspace\", charset=\"UTF-8\"',\n        \"Cache-Control\": \"no-store\",\n      },\n    });\n  // Render terminates TLS before the container; compare against the browser's\n  // Host and forwarded protocol, rather than the internal Node listening URL.\n  const protocol =\n    request.headers.get(\"x-forwarded-proto\") === \"https\"\n      ? \"https:\"\n      : request.nextUrl.protocol;\n  const browserOrigin = `${protocol}//${request.headers.get(\"host\") || request.nextUrl.host}`;\n  if (\n    crossSiteMutation(\n      request.method,\n      request.headers.get(\"origin\"),\n      browserOrigin,\n      request.headers.get(\"sec-fetch-site\"),\n    )\n  ) {\n    return new NextResponse(\"Cross-site requests are not allowed.\", {\n      status: 403,\n    });\n  }\n  return forward(request);\n}\n\nexport const config = { matcher: [\"/workspace/:path*\", \"/api/:path*\"] };\n","commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","github_url":"https://github.com/stingingend/codeatlas/blob/42dd9d487d4fe9ede7f9129bfa90969a129f5511/frontend/proxy.ts","parsing":{"file_id":91,"has_parse_errors":false,"symbol_count":4},"symbols":{"items":[{"id":1198,"file_id":91,"name":"import { NextRequest, NextResponse } from \"next/server\";","qualified_name":"frontend/proxy.ts::import { NextRequest, NextResponse } from \"next/server\";","parent_qualified_name":null,"symbol_type":"import","start_line":1,"end_line":1,"signature":"import { NextRequest, NextResponse } from \"next/server\";"},{"id":1199,"file_id":91,"name":"import { crossSiteMutation, workspaceAccess } from \"./lib/workspace-access\";","qualified_name":"frontend/proxy.ts::import { crossSiteMutation, workspaceAccess } from \"./lib/workspace-access\";","parent_qualified_name":null,"symbol_type":"import","start_line":2,"end_line":2,"signature":"import { crossSiteMutation, workspaceAccess } from \"./lib/workspace-access\";"},{"id":1200,"file_id":91,"name":"forward","qualified_name":"frontend/proxy.ts::forward","parent_qualified_name":null,"symbol_type":"function","start_line":4,"end_line":11,"signature":"function forward(request: NextRequest)"},{"id":1201,"file_id":91,"name":"proxy","qualified_name":"frontend/proxy.ts::proxy","parent_qualified_name":null,"symbol_type":"function","start_line":13,"end_line":58,"signature":"function proxy(request: NextRequest)"}],"total":4,"limit":500,"offset":0}},"graph":{"file_id":91,"ready":true,"commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","total_neighbors":1,"unresolved_imports":1,"self_impor