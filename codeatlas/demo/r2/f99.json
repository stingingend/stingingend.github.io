{"detail":{"file":{"id":99,"repository_id":2,"path":"frontend/tests/workspace-access.test.mjs","language":"JavaScript","content_hash":"3251f706f74bec2c9b53c02e78ff9a8805f7305d400ec397ebf3c6d032a77f57","line_count":74},"source":"import test from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { workspaceAccess, crossSiteMutation } from \"../lib/workspace-access.ts\";\n\nconst env = {\n  WORKSPACE_AUTH_REQUIRED: \"1\",\n  WORKSPACE_USERNAME: \"owner\",\n  WORKSPACE_PASSWORD: \"a-long-test-password\",\n};\nconst basic = (text) => `Basic ${Buffer.from(text).toString(\"base64\")}`;\ntest(\"local workspace remains available when authentication is explicitly unused\", () => {\n  assert.equal(workspaceAccess(null, {}), \"allow\");\n});\ntest(\"hosted workspace fails closed for missing or incomplete credentials\", () => {\n  for (const config of [\n    { WORKSPACE_AUTH_REQUIRED: \"1\" },\n    { WORKSPACE_USERNAME: \"owner\" },\n    { ...env, WORKSPACE_PASSWORD: \"short\" },\n    { ...env, WORKSPACE_USERNAME: \"bad:user\" },\n  ])\n    assert.equal(workspaceAccess(null, config), \"unconfigured\");\n});\ntest(\"workspace requires exact credentials and rejects malformed headers\", () => {\n  assert.equal(\n    workspaceAccess(basic(\"owner:a-long-test-password\"), env),\n    \"allow\",\n  );\n  for (const header of [\n    null,\n    \"Bearer token\",\n    \"Basic !!!!\",\n    basic(\"wrong:a-long-test-password\"),\n    basic(\"owner:wrong\"),\n    `Basic ${\"a\".repeat(5000)}`,\n  ])\n    assert.equal(workspaceAccess(header, env), \"challenge\");\n});\ntest(\"browser mutations must come from the same origin\", () => {\n  assert.equal(\n    crossSiteMutation(\n      \"POST\",\n      \"https://evil.example\",\n      \"https://code.example\",\n      null,\n    ),\n    true,\n  );\n  assert.equal(\n    crossSiteMutation(\"POST\", null, \"https://code.example\", \"cross-site\"),\n    true,\n  );\n  assert.equal(\n    crossSiteMutation(\n      \"POST\",\n      \"https://code.example\",\n      \"https://code.example\",\n      \"same-origin\",\n    ),\n    false,\n  );\n  assert.equal(\n    crossSiteMutation(\n      \"GET\",\n      \"https://evil.example\",\n      \"https://code.example\",\n      \"cross-site\",\n    ),\n    false,\n  );\n  assert.equal(\n    crossSiteMutation(\"POST\", null, \"https://code.example\", null),\n    false,\n  );\n});\n","commit_sha":"42dd9d487d4fe9ede7f9129bfa90969a129f5511","github_url":"https://github.com/stingingend/codeatlas/blob/42dd9d487d4fe9ede7f9129bfa90969a129f5511/frontend/tests/workspace-access.test.mjs","parsing":{"file_id":99,"has_parse_errors":false,"symbol_count":4},"symbols":{"items":[{"id":1228,"file_id":99,"name":"import test from \"node:test\";","qualified_name":"frontend/tests/workspace-access.test.mjs::import test from \"node:test\";","parent_qualified_name":null,"symbol_type":"import","start_line":1,"end_line":1,"signature":"import test from \"node:test\";"},{"id":1229,"file_id":99,"name":"import assert from \"node:assert/strict\";","qualified_name":"frontend/tests/workspace-access.test.mjs::import assert from \"node:assert/strict\";","parent_qualified_name":null,"symbol_type":"import","start_line":2,"end_line":2,"signature":"import assert from \"node:assert/strict\";"},{"id":1230,"file_id":99,"name":"import { workspaceAccess, crossSiteMutation } from \"../lib/workspace-access.ts\";","qualified_name":"frontend/tests/workspace-access.test.mjs::import { workspaceAccess, crossSiteMutation } from \"../lib/workspace-access.ts\";","parent_qualified_name":null,"symbol_type":"import","start_line":3,"end_line":3,"signature":"import { workspaceAccess, crossSiteMutation } from \"../lib/workspace-access.ts\";"},{"id":1231,"file_id":99,"name":"basic","qualified_name":"frontend/tests/workspace-access.test.mjs::basic","parent_qualified_name":null,"symbol_type":"function","start_line":10,"end_line":10,"signature":"(text) =>"}],"total":4,"limit":500,"offset":0}},"graph":{"file_id":99,"ready":